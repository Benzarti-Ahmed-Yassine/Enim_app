rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Autorise l'accès complet aux paramètres uniquement pour l'utilisateur propriétaire
    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Garde l'accès libre pour les mesures de température (ESP32 et Dashboard)
    match /users/{userId}/temperatureMeasurements/{measurementId} {
      allow create, read, update, delete: if true;
    }

    // Protection par défaut pour le reste de la base de données
    match /{document=**} {
      allow read, write: if false;
    }
  }
}