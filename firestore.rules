rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TEMP-ALERT SECURITY RULES
     * Modèle de propriété stricte : Un utilisateur ne peut accéder qu'à ses propres données.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Groupe toutes les règles par utilisateur pour plus de clarté et de fiabilité
    match /users/{userId} {
      
      // Paramètres (document unique 'current')
      match /settings/current {
        allow read, write: if isOwner(userId);
      }

      // Mesures de température (collection historique)
      match /temperatureMeasurements/{id} {
        allow read, write: if isOwner(userId);
      }

      // Événements d'alerte (collection logs)
      match /alertEvents/{id} {
        allow read, write: if isOwner(userId);
      }
    }

    // Interdiction par défaut pour tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}