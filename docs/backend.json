{
  "entities": {
    "UserPreference": {
      "title": "UserPreference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "externalAuthId": { "type": "string" },
        "alertEmail": { "type": "string" },
        "temperatureThreshold": { "type": "number" },
        "unitPreference": { "type": "string" },
        "emailAlerts": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "TemperatureMeasurement": {
      "title": "TemperatureMeasurement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "value": { "type": "number" },
        "temperature": { "type": "number" },
        "resistance": { "type": "number" },
        "unit": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}/settings/current": {
      "schema": "UserPreference",
      "description": "User settings"
    },
    "/users/{userId}/temperatureMeasurements/{measurementId}": {
      "schema": "TemperatureMeasurement",
      "description": "Temperature data"
    }
  }
}